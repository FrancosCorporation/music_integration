# Social Automation Environment
# Frontend URL used to build verification links
FRONTEND_URL=https://francoscorporation.ddns.net

# Google OAuth (YouTube) – place client_secret.json in sessions/youtube/
# Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Instagram / TikTok / etc – session cookies saved in sessions/<platform>/

# Optional: Resend for email notifications (if you add email features)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@francoscorp.com
RESEND_FROM_NAME=Francos Corp

# Database (SQLite file will be created automatically)
# DB_PATH=social_automation/data.db
