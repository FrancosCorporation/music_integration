# Copie para .env e defina uma senha aleatória com pelo menos 16 caracteres.
DASHBOARD_PASSWORD=ALTERE

# UID/GID do usuário que criou as pastas data/ e sessions/ no host.
PUID=1000
PGID=1000

# Para execução local, estes diretórios são relativos ao projeto por padrão.
# Docker Compose sobrescreve DATA_DIR e SESSION_DIR para os volumes persistentes.
# DATA_DIR=./data
# SESSION_DIR=./sessions
